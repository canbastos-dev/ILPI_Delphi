unit uCadastroIdosasController;

interface

uses
  uFrmCadastroIdosas, uDataModule, System.SysUtils;

type
  TCadastroIdosasController = class
  public
    class procedure AbrirCadastroClientes;
  end;

implementation

class procedure TCadastroIdosasController.AbrirCadastroClientes;
var
  Frm: TFormCadastroIdosas;
begin
  // Garante conexão
  uDados.Conectar;

  // Configura Query
  uDados.fdqDados.Close;
  uDados.fdqDados.Open();

  // Cria formulário
  Frm.Create(nil);
//  Frm := TFrmCadastroIdosas.Create(nil);
  Frm.SetDataSet(uDados.fdqDados);

  Frm.Show; // ou ShowModal
end;

end.
